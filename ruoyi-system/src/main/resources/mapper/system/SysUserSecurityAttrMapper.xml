<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ruoyi.system.mapper.SysUserSecurityAttrMapper">

    <resultMap type="SysUserSecurityAttr" id="SysUserSecurityAttrResult">
        <result property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="userName" column="user_name"/>
        <result property="nickName" column="nick_name"/>
        <result property="secretLevel" column="secret_level"/>
        <result property="accessStatus" column="access_status"/>
        <result property="accessStartTime" column="access_start_time"/>
        <result property="accessEndTime" column="access_end_time"/>
        <result property="riskLevel" column="risk_level"/>
        <result property="failCount" column="fail_count"/>
        <result property="lastAccessIp" column="last_access_ip"/>
        <result property="lastAccessTime" column="last_access_time"/>
        <result property="remark" column="remark"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectSysUserSecurityAttrVo">
        select id, user_id, user_name, nick_name, secret_level, access_status,
               access_start_time, access_end_time, risk_level, fail_count,
               last_access_ip, last_access_time, remark, create_by, create_time,
               update_by, update_time
        from sys_user_security_attr
    </sql>

    <select id="selectSysUserSecurityAttrList" parameterType="SysUserSecurityAttr" resultMap="SysUserSecurityAttrResult">
        <include refid="selectSysUserSecurityAttrVo"/>
        <where>
            <if test="userName != null and userName != ''">
                and user_name like concat('%', #{userName}, '%')
            </if>
            <if test="nickName != null and nickName != ''">
                and nick_name like concat('%', #{nickName}, '%')
            </if>
            <if test="secretLevel != null and secretLevel != ''">
                and secret_level = #{secretLevel}
            </if>
            <if test="accessStatus != null and accessStatus != ''">
                and access_status = #{accessStatus}
            </if>
            <if test="riskLevel != null and riskLevel != ''">
                and risk_level = #{riskLevel}
            </if>
        </where>
        order by id desc
    </select>

    <select id="selectSysUserSecurityAttrById" parameterType="Long" resultMap="SysUserSecurityAttrResult">
        <include refid="selectSysUserSecurityAttrVo"/>
        where id = #{id}
    </select>

    <select id="selectSysUserSecurityAttrByUserId" parameterType="Long" resultMap="SysUserSecurityAttrResult">
        <include refid="selectSysUserSecurityAttrVo"/>
        where user_id = #{userId}
    </select>

    <insert id="insertSysUserSecurityAttr" parameterType="SysUserSecurityAttr" useGeneratedKeys="true" keyProperty="id">
        insert into sys_user_security_attr
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="userName != null">user_name,</if>
            <if test="nickName != null">nick_name,</if>
            <if test="secretLevel != null">secret_level,</if>
            <if test="accessStatus != null">access_status,</if>
            <if test="accessStartTime != null">access_start_time,</if>
            <if test="accessEndTime != null">access_end_time,</if>
            <if test="riskLevel != null">risk_level,</if>
            <if test="failCount != null">fail_count,</if>
            <if test="lastAccessIp != null">last_access_ip,</if>
            <if test="lastAccessTime != null">last_access_time,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            create_time,
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="userName != null">#{userName},</if>
            <if test="nickName != null">#{nickName},</if>
            <if test="secretLevel != null">#{secretLevel},</if>
            <if test="accessStatus != null">#{accessStatus},</if>
            <if test="accessStartTime != null">#{accessStartTime},</if>
            <if test="accessEndTime != null">#{accessEndTime},</if>
            <if test="riskLevel != null">#{riskLevel},</if>
            <if test="failCount != null">#{failCount},</if>
            <if test="lastAccessIp != null">#{lastAccessIp},</if>
            <if test="lastAccessTime != null">#{lastAccessTime},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            now(),
        </trim>
    </insert>

    <update id="updateSysUserSecurityAttr" parameterType="SysUserSecurityAttr">
        update sys_user_security_attr
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="userName != null">user_name = #{userName},</if>
            <if test="nickName != null">nick_name = #{nickName},</if>
            <if test="secretLevel != null">secret_level = #{secretLevel},</if>
            <if test="accessStatus != null">access_status = #{accessStatus},</if>
            <if test="accessStartTime != null">access_start_time = #{accessStartTime},</if>
            <if test="accessEndTime != null">access_end_time = #{accessEndTime},</if>
            <if test="riskLevel != null">risk_level = #{riskLevel},</if>
            <if test="failCount != null">fail_count = #{failCount},</if>
            <if test="lastAccessIp != null">last_access_ip = #{lastAccessIp},</if>
            <if test="lastAccessTime != null">last_access_time = #{lastAccessTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = now()
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteSysUserSecurityAttrById" parameterType="Long">
        delete from sys_user_security_attr where id = #{id}
    </delete>

    <delete id="deleteSysUserSecurityAttrByIds" parameterType="String">
        delete from sys_user_security_attr where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
